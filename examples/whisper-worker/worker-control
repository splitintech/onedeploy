#!/usr/bin/env python3
"""Fixed localhost control client; token never enters command arguments."""
import http.client
import json
import os
import re
from pathlib import Path
import sys

actions = {'qualify':('POST','/qualify'), 'drain':('POST','/drain'),
           'qualify-status':('GET','/qualification-status'), 'drain-status':('GET','/status')}
body=None
if len(sys.argv)==5 and sys.argv[1]=='infer' and sys.argv[2]=='--input' and sys.argv[4]=='--json':
    name=sys.argv[3]
    if not re.fullmatch(r'/tmp/od-job-[A-Za-z0-9-]{1,64}\.json',name): raise SystemExit(2)
    path_obj=Path(name)
    if path_obj.is_symlink() or path_obj.stat().st_size>14*1024*1024:raise SystemExit(2)
    body=path_obj.read_bytes();method,path='POST','/infer'
else:
    if len(sys.argv) != 3 or sys.argv[2] != '--json' or sys.argv[1] not in actions:
        raise SystemExit(2)
    method,path=actions[sys.argv[1]]
token=Path(os.environ['ONEDEPLOY_WORKER_TOKEN_FILE']).read_text().strip()
timeout=80
if sys.argv[1]=='infer':
    try: timeout=int(os.environ.get('ONEDEPLOY_REQUEST_TIMEOUT_SECONDS','80'))
    except ValueError: raise SystemExit(2)
    if not 1 <= timeout <= 3600: raise SystemExit(2)
conn=http.client.HTTPConnection('127.0.0.1',int(os.environ.get('ONEDEPLOY_WORKER_PORT','8766')),timeout=timeout)
conn.request(method,path,body=body,headers={'Authorization':'Bearer '+token})
response=conn.getresponse();raw=response.read(1048577)
if response.status != 200 or len(raw)>1048576: raise SystemExit(1)
data=json.loads(raw)
if sys.argv[1]=='drain-status':data={'completed':data.get('accepting_jobs') is False,'evidence':data}
print(json.dumps(data))
