{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
    },
    "provider": {
      "enum": [
        "daytona",
        "railway",
        "modal"
      ]
    },
    "profile": {
      "enum": [
        "docker-http",
        "asgi",
        "worker",
        "model"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "trust_code": {
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "dockerfile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "snapshot_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 64
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "health_path": {
          "type": "string",
          "pattern": "^/(?!/)[A-Za-z0-9_./-]*$",
          "maxLength": 2048
        },
        "ready_url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "ready_path": {
          "type": "string",
          "pattern": "^/(?!/)[A-Za-z0-9_./-]*$",
          "maxLength": 2048
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "string",
              "integer",
              "boolean"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "default": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$"
          },
          "required_if": {
            "type": "object",
            "properties": {
              "variable": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "equals": {
                "type": [
                  "string",
                  "integer",
                  "boolean"
                ]
              }
            },
            "required": [
              "variable",
              "equals"
            ],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "maxProperties": 128
    },
    "target": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
        },
        "service": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
        },
        "sandbox": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
        },
        "region": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
        },
        "app": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
        },
        "function": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
        },
        "mode": {
          "enum": [
            "create",
            "existing"
          ]
        }
      },
      "required": [
        "account"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "disk_gb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "auto_stop_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "private",
            "existing"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "storage": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
          },
          "resource_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
          },
          "mount_path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 1024
          },
          "kind": {
            "enum": [
              "volume",
              "model-cache"
            ]
          },
          "access": {
            "enum": [
              "read-only",
              "read-write"
            ]
          },
          "single_writer": {
            "type": "boolean"
          },
          "attachment": {
            "enum": [
              "attach",
              "existing"
            ]
          }
        },
        "required": [
          "name",
          "resource_id",
          "mount_path",
          "kind",
          "access",
          "single_writer"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
          },
          "kind": {
            "enum": [
              "postgres",
              "redis",
              "http"
            ]
          },
          "variable": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "tls": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "kind",
          "variable",
          "tls",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,254}$"
          },
          "path": {
            "type": "string",
            "pattern": "^/(?!/)[A-Za-z0-9_./-]*$",
            "maxLength": 2048
          },
          "expected_status": {
            "type": "integer",
            "minimum": 200,
            "maximum": 299
          },
          "auth_variable": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "unauthenticated_status": {
            "enum": [
              401,
              403
            ]
          },
          "safety": {
            "const": "read-only"
          }
        },
        "required": [
          "name",
          "path",
          "safety"
        ],
        "additionalProperties": false
      }
    },
    "rollback": {
      "type": "object",
      "properties": {
        "compatible": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "name",
    "provider",
    "profile",
    "source",
    "target"
  ],
  "additionalProperties": false
}
