{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "timestamp",
    "phase"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string"
    },
    "deployment_id": {
      "type": "string"
    },
    "operation_id": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "state": {
      "type": "string"
    }
  }
}
